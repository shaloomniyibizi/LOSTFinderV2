# Only needed when running a branch WITHOUT Docker (uvicorn in a terminal).
# Copy to backend/.env and fill in. The branch reads it automatically at start-up.
# BRANCH_ID, BRANCH_NAME and DATABASE_URL differ per branch: set those in each terminal instead.
# Never commit .env.

JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
ADMIN_EMAIL=admin@lostfound.local
ADMIN_PASSWORD=change-me-admin-password
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
CLOUDINARY_URL=
PHOTO_DIR=../photos-shared
