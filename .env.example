# =====================================================================
#  LostFinder private settings
#  1. Copy this file to ".env" (same folder as docker-compose.yml)
#  2. Replace every "change-me" value with your own
#  3. NEVER commit .env to Git or share it (it is already in .gitignore)
#
#  Use only letters, digits, "-" and "_" in passwords: they are put inside
#  connection URLs, where characters like @ : / # % would break them.
#  Make a strong random value with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# =====================================================================

# --- PostgreSQL (the three branch databases) ---
# If you change these after the first start, run "docker compose down -v" (deletes the data).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password

# --- Login tokens: one long random secret, shared by all three branches ---
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# --- First admin account, created on every branch at first start ---
ADMIN_EMAIL=admin@lostfound.local
ADMIN_PASSWORD=change-me-admin-password

# --- RabbitMQ (also the login for the dashboard at http://localhost:15672) ---
RABBITMQ_USER=lostfinder
RABBITMQ_PASSWORD=change-me-rabbit-password
RABBITMQ_ERLANG_COOKIE=change-me-erlang-cookie

# --- Photos: Cloudinary free plan (optional) ---
# Leave empty to keep photos in a folder shared by the three branches.
# Get it at https://console.cloudinary.com -> Settings -> API Keys -> "API environment variable".
CLOUDINARY_URL=

# --- Optional tuning ---
# PHOTO_STORAGE=          # local | cloudinary | seaweedfs (empty = automatic)
# MATCH_THRESHOLD=60      # minimum score (out of 100) for a possible match
