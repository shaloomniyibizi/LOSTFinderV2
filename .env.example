# Copy this file to ".env" (same folder as docker-compose.yml) to use Cloudinary for photos.
# Get the value from https://console.cloudinary.com -> Settings (gear) -> API Keys -> "API environment variable".
# It looks like:  cloudinary://123456789012345:AbCdEfGhIjKlMnOpQrStUvWxYz0@your-cloud-name
# Leave it empty (or delete .env) to store photos in a folder shared by the three branches.
CLOUDINARY_URL=
